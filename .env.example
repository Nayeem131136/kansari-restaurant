# JWT_SECRET: Used to sign and verify admin authentication tokens.
# Set this to a long, random string before deploying to production.
JWT_SECRET="change_this_to_a_long_random_secret"

# Supabase — used for the database and for storing admin-uploaded images.
# Get these from your Supabase project: Settings -> API
#   SUPABASE_URL      -> "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY -> "service_role" secret key (NOT the anon/public key —
#                                 this one bypasses Row Level Security and must
#                                 never be exposed to the browser/frontend)
SUPABASE_URL="https://xxxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-or-secret-key"

# PORT: Optional. Defaults to 3000 if not set.
# PORT=3000
